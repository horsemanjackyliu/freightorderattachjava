{
    "_version": "1.65.0",
    "sap.app": {
        "id": "freightorderattachjavaui5",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:lrop",
            "version": "1.17.4",
            "toolsId": "67a91d46-3937-4e16-ae0f-6917f5337240"
        },
        "dataSources": {
            "mainService": {
                "uri": "odata/v4/AdminService/",
                "type": "OData",
                "settings": {
                    "annotations": [],
                    "odataVersion": "4.0"
                }
            }
        },
        "crossNavigation": {
            "inbounds": {
                "freightorderattachjavaui5-display": {
                    "semanticObject": "freightorderattachjavaui5",
                    "action": "display",
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.133.2",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.fe.templates": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "freightorderattachjavaui5.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            },
            "@i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/i18n.properties"
            }
        },
        "resources": {
            "css": []
        },
        "routing": {
            "config": {},
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "FreightOrderList",
                    "target": "FreightOrderList"
                },
                {
                    "pattern": "FreightOrder({key}):?query:",
                    "name": "FreightOrderObjectPage",
                    "target": "FreightOrderObjectPage"
                },
                {
                    "pattern": "FreightOrder({key})/FreightOrderItems({key2}):?query:",
                    "name": "FreightOrderItemObjectPage",
                    "target": "FreightOrderItemObjectPage"
                }
            ],
            "targets": {
                "FreightOrderList": {
                    "type": "Component",
                    "id": "FreightOrderList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/FreightOrder",
                            "variantManagement": "Page",
                            "navigation": {
                                "FreightOrder": {
                                    "detail": {
                                        "route": "FreightOrderObjectPage"
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "ResponsiveTable"
                                    }
                                }
                            }
                        }
                    }
                },
                "FreightOrderObjectPage": {
                    "type": "Component",
                    "id": "FreightOrderObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "editableHeaderContent": false,
                            "contextPath": "/FreightOrder",
                            "navigation": {
                                "FreightOrderItems": {
                                    "detail": {
                                        "route": "FreightOrderItemObjectPage"
                                    }
                                }
                            }
                        }
                    }
                },
                "FreightOrderItemObjectPage": {
                    "type": "Component",
                    "id": "FreightOrderItemObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "editableHeaderContent": false,
                            "contextPath": "/FreightOrder/FreightOrderItems"
                        }
                    }
                }
            }
        }
    },
    "sap.fiori": {
        "registrationIds": [],
        "archeType": "transactional"
    },
    "sap.cloud": {
        "public": true,
        "service": "freightorderattachjava.service"
    }
}
